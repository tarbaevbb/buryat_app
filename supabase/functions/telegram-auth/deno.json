{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.45.4"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-import-prefix"]
